

<div class="patient-dashboard">

  <!-- =====================================================
       SIDEBAR
  ====================================================== -->

  <aside class="dashboard-sidebar">

    <div class="hospital-brand">

      <div class="hospital-logo">
        🏥
      </div>

      <h2>PARAS HOSPITAL</h2>

      <p>Patient Portal</p>

    </div>


    <!-- NAVIGATION -->

    <nav class="dashboard-nav">

      <%= link_to patient_dashboard_path,
          class: "dashboard-nav-link active" do %>

        <span class="nav-icon">🏠</span>
        <span>Dashboard</span>

      <% end %>


      <%= link_to patient_profile_path,
          class: "dashboard-nav-link" do %>

        <span class="nav-icon">👤</span>
        <span>My Profile</span>

      <% end %>


      <%= link_to appointments_path,
          class: "dashboard-nav-link" do %>

        <span class="nav-icon">📅</span>
        <span>Appointments</span>

      <% end %>


      <%= link_to medical_records_path,
          class: "dashboard-nav-link" do %>

        <span class="nav-icon">📋</span>
        <span>Medical Records</span>

      <% end %>


      <%= link_to lab_reports_path,
          class: "dashboard-nav-link" do %>

        <span class="nav-icon">🧪</span>
        <span>Lab Reports</span>

      <% end %>


      <div class="nav-divider"></div>


      <%= link_to logout_path,
          data: { turbo_method: :delete },
          class: "dashboard-nav-link logout-link" do %>

        <span class="nav-icon">🚪</span>
        <span>Logout</span>

      <% end %>

    </nav>


    <!-- SUPPORT -->

    <div class="support-card">

      <div class="support-icon">
        🎧
      </div>

      <h3>Need Help?</h3>

      <p>
        Our support team is available 24/7
      </p>

      <strong>
        +91 98765 43210
      </strong>

    </div>

  </aside>


  <!-- =====================================================
       MAIN CONTENT
  ====================================================== -->

  <main class="dashboard-main">


    <!-- HEADER -->

    <header class="dashboard-header">

      <div>

        <p class="welcome-text">
          Good Morning, Patient 👋
        </p>

        <h1>
          <%= @patient.first_name %>
          <%= @patient.last_name %>
        </h1>

        <p class="dashboard-subtitle">
          Welcome to your health dashboard
        </p>

      </div>


      <!-- PROFILE -->

      <div class="dashboard-profile">

        <div class="profile-avatar">

          <%= @patient.first_name.to_s.first&.upcase || "P" %>

        </div>

        <div class="profile-info">

          <strong>
            <%= @patient.first_name %>
            <%= @patient.last_name %>
          </strong>

          <span>Patient</span>

        </div>

        <span class="profile-arrow">
          ▾
        </span>

      </div>

    </header>


    <!-- =====================================================
         STAT CARDS
    ====================================================== -->

    <section class="dashboard-stat-grid">


      <!-- APPOINTMENTS -->

      <div class="stat-card">

        <div class="stat-icon appointment-icon">
          📅
        </div>

        <div class="stat-content">

          <span>Upcoming</span>
          <strong>Appointments</strong>

          <h2>
            <%= @appointment_count %>
          </h2>

          <%= link_to appointments_path do %>
            View all →
          <% end %>

        </div>

      </div>


      <!-- MEDICAL REPORTS -->

      <div class="stat-card">

        <div class="stat-icon report-icon">
          📄
        </div>

        <div class="stat-content">

          <span>Medical</span>
          <strong>Reports</strong>

          <h2>
            <%= @medical_report_count %>
          </h2>

          <%= link_to medical_records_path do %>
            View all →
          <% end %>

        </div>

      </div>


      <!-- PRESCRIPTIONS -->

      <div class="stat-card">

        <div class="stat-icon prescription-icon">
          💊
        </div>

        <div class="stat-content">

          <span>My</span>
          <strong>Prescriptions</strong>

          <h2>0</h2>

          <%= link_to prescriptions_path do %>
            View all →
          <% end %>

        </div>

      </div>


      <!-- BILLS -->

      <div class="stat-card">

        <div class="stat-icon bill-icon">
          ₹
        </div>

        <div class="stat-content">

          <span>Pending</span>
          <strong>Bills</strong>

          <h2>₹0</h2>

          <%= link_to bills_path do %>
            View bills →
          <% end %>

        </div>

      </div>

    </section>


    <!-- =====================================================
         MIDDLE SECTION
    ====================================================== -->

    <section class="dashboard-two-column">


      <!-- UPCOMING APPOINTMENT -->

      <div class="dashboard-card appointment-card">

        <div class="card-header">

          <div>
            <span class="card-header-icon">📅</span>
            <h2>Upcoming Appointment</h2>
          </div>

          <%= link_to "View all",
              appointments_path,
              class: "card-link" %>

        </div>


        <% if @upcoming_appointments.any? %>

          <% appointment = @upcoming_appointments.first %>

          <div class="appointment-content">

            <div class="doctor-avatar">
              👨‍⚕️
            </div>


            <div class="doctor-info">

              <h3>
                <%= appointment.respond_to?(:doctor_name) &&
                    appointment.doctor_name.present? ?
                    appointment.doctor_name :
                    "Doctor" %>
              </h3>

              <p>Doctor</p>

              <span>
                Paras Hospital
              </span>

            </div>


            <div class="appointment-details">

              <div>
                <span>📅</span>

                <strong>
                  <%= appointment.appointment_date.strftime("%d %b %Y") %>
                </strong>
              </div>

              <% if appointment.respond_to?(:appointment_time) &&
                    appointment.appointment_time.present? %>

                <div>
                  <span>🕐</span>

                  <strong>
                    <%= appointment.appointment_time.strftime("%I:%M %p") %>
                  </strong>
                </div>

              <% end %>

            </div>


            <div class="appointment-status">

              <span>
                ● Confirmed
              </span>

              <%= link_to "View Appointment",
                  appointment_path(appointment) %>

            </div>

          </div>

        <% else %>

          <div class="empty-dashboard">

            <div>📅</div>

            <h3>No Upcoming Appointments</h3>

            <p>
              You don't have any upcoming appointments.
            </p>

            <%= link_to "Book Appointment",
                new_appointment_path,
                class: "primary-dashboard-btn" %>

          </div>

        <% end %>

      </div>


      <!-- QUICK ACTIONS -->

      <div class="dashboard-card quick-actions-card">

        <div class="card-header">

          <div>
            <span class="card-header-icon">⚡</span>
            <h2>Quick Actions</h2>
          </div>

        </div>


        <div class="quick-actions">


          <%= link_to new_appointment_path,
              class: "quick-action" do %>

            <span class="quick-action-icon">📅</span>

            <div>
              <strong>Book Appointment</strong>
              <small>Schedule a new appointment</small>
            </div>

            <span>›</span>

          <% end %>


          <%= link_to new_medical_record_path,
              class: "quick-action" do %>

            <span class="quick-action-icon">⬆️</span>

            <div>
              <strong>Upload Medical Report</strong>
              <small>Upload your medical reports</small>
            </div>

            <span>›</span>

          <% end %>


          <%= link_to prescriptions_path,
              class: "quick-action" do %>

            <span class="quick-action-icon">📄</span>

            <div>
              <strong>View Prescriptions</strong>
              <small>View your prescriptions</small>
            </div>

            <span>›</span>

          <% end %>

        </div>

      </div>

    </section>


    <!-- =====================================================
         BOTTOM SECTION
    ====================================================== -->

    <section class="dashboard-bottom-grid">


      <!-- RECENT REPORTS -->

      <div class="dashboard-card reports-card">

        <div class="card-header">

          <div>
            <span class="card-header-icon">📋</span>
            <h2>Recent Medical Reports</h2>
          </div>

          <%= link_to "View all",
              medical_records_path,
              class: "card-link" %>

        </div>


        <% if @medical_reports.any? %>

          <div class="reports-table-wrapper">

            <table class="reports-table">

              <thead>

                <tr>
                  <th>Report Type</th>
                  <th>Date</th>
                  <th>Department</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>

              </thead>


              <tbody>

                <% @medical_reports.each do |report| %>

                  <tr>

                    <td>
                      <strong>
                        <%= report.report_type.presence ||
                            "Medical Report" %>
                      </strong>
                    </td>

                    <td>
                      <%= report.report_date&.strftime("%d %b %Y") ||
                          "N/A" %>
                    </td>

                    <td>
                      <%= report.department.presence ||
                          "General" %>
                    </td>

                    <td>

                      <span class="report-status">
                        <%= report.status.presence ||
                            "Completed" %>
                      </span>

                    </td>

                    <td>

                      <%= link_to "View",
                          medical_record_path(report),
                          class: "table-view-btn" %>

                    </td>

                  </tr>

                <% end %>

              </tbody>

            </table>

          </div>

        <% else %>

          <div class="empty-dashboard">

            <div>📋</div>

            <h3>No Medical Reports</h3>

            <p>
              Upload your first medical report.
            </p>

            <%= link_to "Upload Report",
                new_medical_record_path,
                class: "primary-dashboard-btn" %>

          </div>

        <% end %>

      </div>


      <!-- HEALTH SUMMARY -->

      <div class="dashboard-card health-card">

        <div class="card-header">

          <div>
            <span class="card-header-icon">❤️</span>
            <h2>Health Summary</h2>
          </div>

        </div>


        <div class="health-list">

          <div class="health-item">

            <span class="health-icon">🩸</span>

            <div>
              <small>Blood Group</small>
              <strong>Not Available</strong>
            </div>

          </div>


          <div class="health-item">

            <span class="health-icon">🎂</span>

            <div>
              <small>Date of Birth</small>

              <strong>
                Not Available
              </strong>

            </div>

          </div>


          <div class="health-item">

            <span class="health-icon">⚧</span>

            <div>

              <small>Gender</small>

              <strong>
                <%= @patient.gender.presence || "Not Available" %>
              </strong>

            </div>

          </div>


          <div class="health-item">

            <span class="health-icon">📞</span>

            <div>

              <small>Phone</small>

              <strong>
                <%= @patient.phone.presence || "Not Available" %>
              </strong>

            </div>

          </div>

        </div>


        <%= link_to "View Full Profile",
            patient_profile_path,
            class: "profile-dashboard-btn" %>

      </div>


    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="dashboard-footer">

      <span>
        © <%= Date.current.year %> Paras Hospital.
        All rights reserved.
      </span>

      <div>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Contact Us</a>
      </div>

    </footer>

  </main>

</div>