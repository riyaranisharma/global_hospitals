<div class="doctor-schedule-page">

  <div class="schedule-header">

    <div>
      <h1>My Schedule</h1>
      <p>Manage your consultation schedule and availability</p>
    </div>

    <%= link_to "+ Add Schedule",
        new_doctor_schedule_path,
        class: "add-schedule-btn" %>

  </div>


  <% if notice.present? %>

    <div class="schedule-alert success">
      <%= notice %>
    </div>

  <% end %>


  <% if alert.present? %>

    <div class="schedule-alert error">
      <%= alert %>
    </div>

  <% end %>


  <div class="schedule-card">

    <div class="schedule-card-header">

      <div>
        <h2>Weekly Schedule</h2>
        <p>Your available consultation timings</p>
      </div>

      <div class="schedule-count">
        <%= @schedules.count %> Schedules
      </div>

    </div>


    <% if @schedules.any? %>

      <div class="schedule-table-wrapper">

        <table class="schedule-table">

          <thead>

            <tr>
              <th>Day</th>
              <th>Start Time</th>
              <th>End Time</th>
              <th>Break</th>
              <th>Slot Duration</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>

          </thead>


          <tbody>

            <% @schedules.each do |schedule| %>

              <tr>

                <td>
                  <strong>
                    <%= schedule.day_of_week %>
                  </strong>
                </td>


                <td>
                  <%= schedule.start_time.strftime("%I:%M %p") %>
                </td>


                <td>
                  <%= schedule.end_time.strftime("%I:%M %p") %>
                </td>


                <td>

                  <% if schedule.break_start.present? &&
                        schedule.break_end.present? %>

                    <%= schedule.break_start.strftime("%I:%M %p") %>
                    -
                    <%= schedule.break_end.strftime("%I:%M %p") %>

                  <% else %>

                    No Break

                  <% end %>

                </td>


                <td>
                  <%= schedule.slot_duration %> mins
                </td>


                <td>

                  <% if schedule.status == "active" %>

                    <span class="status-badge active">
                      Active
                    </span>

                  <% else %>

                    <span class="status-badge inactive">
                      Inactive
                    </span>

                  <% end %>

                </td>


                <td>

                  <div class="schedule-actions">

                    <%= link_to "Edit",
                        edit_doctor_schedule_path(schedule),
                        class: "edit-btn" %>


                    <%= button_to "Delete",
                        doctor_schedule_path(schedule),
                        method: :delete,
                        class: "delete-btn",
                        data: {
                          turbo_confirm: "Are you sure you want to delete this schedule?"
                        } %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    <% else %>

      <div class="empty-schedule">

        <div class="empty-icon">
          📅
        </div>

        <h3>No Schedule Added</h3>

        <p>
          You haven't created any consultation schedule yet.
        </p>

        <%= link_to "Create Schedule",
            new_doctor_schedule_path,
            class: "add-schedule-btn" %>

      </div>

    <% end %>

  </div>

</div>