<div class="appointment-form-card">

  <%= form_with model: @appointment, local: true do |form| %>

    <% if @appointment.errors.any? %>
      <div class="form-errors">
        <h3>
          <%= pluralize(@appointment.errors.count, "error") %>
          prevented this appointment from being saved:
        </h3>

        <ul>
          <% @appointment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Doctor -->
    <div class="form-group">
      <%= form.label :doctor_name, "Doctor Name" %>

      <%= form.text_field :doctor_name,
          placeholder: "Enter doctor name",
          class: "form-control",
          required: true %>
    </div>

    <!-- Department -->
    <div class="form-group">
      <%= form.label :department, "Department" %>

      <%= form.select :department,
          [
            ["Cardiology", "Cardiology"],
            ["Dermatology", "Dermatology"],
            ["Orthopedics", "Orthopedics"],
            ["Gynecology", "Gynecology"],
            ["General Medicine", "General Medicine"],
            ["Neurology", "Neurology"],
            ["Pediatrics", "Pediatrics"]
          ],
          { prompt: "Select Department" },
          class: "form-control",
          required: true %>
    </div>

    <!-- Date & Time -->
    <div class="form-row">

      <div class="form-group">
        <%= form.label :appointment_date, "Appointment Date" %>

        <%= form.date_field :appointment_date,
            class: "form-control",
            required: true %>
      </div>

      <div class="form-group">
        <%= form.label :appointment_time, "Appointment Time" %>

        <%= form.time_field :appointment_time,
            class: "form-control",
            required: true %>
      </div>

    </div>

    <!-- Status -->
    <div class="form-group">

      <%= form.label :status, "Appointment Status" %>

      <%= form.select :status,
          [
            ["Pending", "Pending"],
            ["Confirmed", "Confirmed"],
            ["Completed", "Completed"],
            ["Cancelled", "Cancelled"]
          ],
          { selected: @appointment.status.presence || "Pending" },
          class: "form-control",
          required: true %>

    </div>

    <!-- Buttons -->
    <div class="form-actions">

      <%= link_to "Cancel",
          appointments_path,
          class: "cancel-btn" %>

      <%= form.submit(
          @appointment.new_record? ? "Book Appointment" : "Update Appointment",
          class: "submit-btn"
      ) %>

    </div>

  <% end %>

</div>