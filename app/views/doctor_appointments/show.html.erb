<div class="doctor-page">

  <div class="doctor-page-header">

    <div>
      <h1>Appointment Details</h1>
      <p>View complete appointment information</p>
    </div>

    <%= link_to "← All Appointments",
        doctor_appointments_path,
        class: "back-btn" %>

  </div>


  <% if notice %>
    <div class="success-message">
      <%= notice %>
    </div>
  <% end %>


  <div class="appointment-detail-card">

    <div class="detail-header">

      <div class="detail-patient">

        <div class="detail-avatar">
          👤
        </div>

        <div>

          <h2>
            <% if @appointment.patient %>

              <%= @appointment.patient.first_name %>
              <%= @appointment.patient.last_name %>

            <% else %>

              Patient

            <% end %>
          </h2>

          <p>Patient Appointment</p>

        </div>

      </div>


      <% status = @appointment.status.to_s.downcase %>

      <span class="appointment-status <%= status %>">
        <%= @appointment.status.presence || "Pending" %>
      </span>

    </div>


    <div class="detail-grid">

      <div class="detail-item">

        <span>Doctor</span>

        <strong>
          Dr.
          <%= current_user.first_name %>
          <%= current_user.last_name %>
        </strong>

      </div>


      <div class="detail-item">

        <span>Department</span>

        <strong>
          <%= @appointment.department.presence || "General" %>
        </strong>

      </div>


      <div class="detail-item">

        <span>Appointment Date</span>

        <strong>

          <%= @appointment.appointment_date.present? ?
              @appointment.appointment_date.strftime("%d %B %Y") :
              "-" %>

        </strong>

      </div>


      <div class="detail-item">

        <span>Appointment Time</span>

        <strong>

          <%= @appointment.appointment_time.present? ?
              @appointment.appointment_time.strftime("%I:%M %p") :
              "-" %>

        </strong>

      </div>


      <div class="detail-item">

        <span>Patient Email</span>

        <strong>

          <%= @appointment.patient&.email || "-" %>

        </strong>

      </div>


      <div class="detail-item">

        <span>Patient Phone</span>

        <strong>

          <%= @appointment.patient&.phone || "-" %>

        </strong>

      </div>

    </div>


    <div class="detail-actions">

      <%= link_to "Edit Appointment",
          edit_doctor_appointment_path(@appointment),
          class: "submit-btn" %>

      <%= button_to "Delete Appointment",
          doctor_appointment_path(@appointment),
          method: :delete,
          class: "delete-large-btn",
          data: {
            turbo_confirm: "Are you sure you want to delete this appointment?"
          } %>

    </div>

  </div>

</div>