<%= form_with model: @appointment,
    url: @appointment.new_record? ?
      doctor_appointments_path :
      doctor_appointment_path(@appointment),
    local: true do |form| %>

  <% if @appointment.errors.any? %>
    <div class="form-errors">
      <h3>
        <%= pluralize(@appointment.errors.count, "error") %>
        prevented this appointment from being saved:
      </h3>

      <ul>
        <% @appointment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Patient Name -->
  <div class="form-group">
    <%= form.label :patient_name, "Patient Name" %>

    <%= form.text_field :patient_name,
        placeholder: "Enter patient name",
        class: "form-control" %>
  </div>

  <!-- Department -->
  <div class="form-group">
    <%= form.label :department, "Department" %>

    <%= form.select :department,
        [
          "Cardiology",
          "Neurology",
          "Orthopedics",
          "Dermatology",
          "General Medicine",
          "Pediatrics",
          "Gynecology",
          "ENT"
        ],
        { prompt: "Select Department" },
        { class: "form-control" } %>
  </div>

  <!-- Date and Time -->
  <div class="form-row">

    <div class="form-group">
      <%= form.label :appointment_date, "Appointment Date" %>

      <%= form.date_field :appointment_date,
          class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :appointment_time, "Appointment Time" %>

      <%= form.time_field :appointment_time,
          class: "form-control" %>
    </div>

  </div>

  <!-- Status -->
  <div class="form-group">
    <%= form.label :status, "Status" %>

    <%= form.select :status,
        [
          "Pending",
          "Confirmed",
          "Completed",
          "Cancelled"
        ],
        { prompt: "Select Status" },
        { class: "form-control" } %>
  </div>

  <!-- Buttons -->
  <div class="form-actions">

    <%= link_to "Cancel",
        doctor_appointments_path,
        class: "cancel-btn" %>

    <%= form.submit(
        @appointment.new_record? ?
        "Create Appointment" :
        "Update Appointment",
        class: "create-btn"
    ) %>

  </div>

<% end %>