<div class="patient-profile-page">

  <div class="profile-page-header">

    <div>
      <h1>Edit Patient Profile</h1>
      <p>Update your personal information</p>
    </div>

    <%= link_to "← Back to Profile",
        patient_profile_path,
        class: "back-profile-btn" %>

  </div>


  <div class="edit-profile-card">

    <%= form_with model: @patient,
        url: patient_profile_path,
        method: :patch,
        local: true do |form| %>


      <% if @patient.errors.any? %>

        <div class="form-errors">
          <h3>Please fix the following errors:</h3>

          <ul>
            <% @patient.errors.full_messages.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>

      <% end %>


      <!-- PERSONAL INFORMATION -->

      <div class="form-section">

        <h2>👤 Personal Information</h2>

        <div class="form-grid">

          <div class="form-group">
            <%= form.label :first_name, "First Name" %>
            <%= form.text_field :first_name %>
          </div>

          <div class="form-group">
            <%= form.label :last_name, "Last Name" %>
            <%= form.text_field :last_name %>
          </div>

          <div class="form-group">
            <%= form.label :date_of_birth, "Date of Birth" %>
            <%= form.date_field :date_of_birth %>
          </div>

          <div class="form-group">
            <%= form.label :gender %>

            <%= form.select :gender,
                ["male", "female", "other"],
                { prompt: "Select Gender" } %>
          </div>

          <div class="form-group">
            <%= form.label :blood_group, "Blood Group" %>

            <%= form.select :blood_group,
                ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
                { prompt: "Select Blood Group" } %>
          </div>

          <div class="form-group">
            <%= form.label :marital_status, "Marital Status" %>

            <%= form.select :marital_status,
                ["Single", "Married", "Other"],
                { prompt: "Select Status" } %>
          </div>

          <div class="form-group">
            <%= form.label :nationality %>
            <%= form.text_field :nationality %>
          </div>

          <div class="form-group">
            <%= form.label :preferred_language, "Preferred Language" %>
            <%= form.text_field :preferred_language %>
          </div>

        </div>

      </div>


      <!-- CONTACT INFORMATION -->

      <div class="form-section">

        <h2>📞 Contact Information</h2>

        <div class="form-grid">

          <div class="form-group">
            <%= form.label :email %>
            <%= form.email_field :email %>
          </div>

          <div class="form-group">
            <%= form.label :phone %>
            <%= form.telephone_field :phone %>
          </div>

          <div class="form-group">
            <%= form.label :alternate_phone, "Alternate Phone" %>
            <%= form.telephone_field :alternate_phone %>
          </div>

          <div class="form-group full-width">
            <%= form.label :address %>
            <%= form.text_area :address, rows: 3 %>
          </div>

          <div class="form-group">
            <%= form.label :city %>
            <%= form.text_field :city %>
          </div>

          <div class="form-group">
            <%= form.label :state %>
            <%= form.text_field :state %>
          </div>

          <div class="form-group">
            <%= form.label :pin_code, "PIN Code" %>
            <%= form.text_field :pin_code %>
          </div>

        </div>

      </div>


      <!-- EMERGENCY CONTACT -->

      <div class="form-section">

        <h2>🚨 Emergency Contact</h2>

        <div class="form-grid">

          <div class="form-group">
            <%= form.label :emergency_contact_name, "Contact Name" %>
            <%= form.text_field :emergency_contact_name %>
          </div>

          <div class="form-group">
            <%= form.label :emergency_relationship, "Relationship" %>
            <%= form.text_field :emergency_relationship %>
          </div>

          <div class="form-group">
            <%= form.label :emergency_phone, "Phone Number" %>
            <%= form.telephone_field :emergency_phone %>
          </div>

        </div>

      </div>


      <!-- MEDICAL INFORMATION -->

      <div class="form-section">

        <h2>❤️ Medical Information</h2>

        <div class="form-grid">

          <div class="form-group full-width">
            <%= form.label :allergies %>
            <%= form.text_area :allergies, rows: 3 %>
          </div>

          <div class="form-group full-width">
            <%= form.label :chronic_conditions, "Chronic Conditions" %>
            <%= form.text_area :chronic_conditions, rows: 3 %>
          </div>

          <div class="form-group full-width">
            <%= form.label :current_medications, "Current Medications" %>
            <%= form.text_area :current_medications, rows: 3 %>
          </div>

          <div class="form-group">
            <%= form.label :smoking_status, "Smoking Status" %>

            <%= form.select :smoking_status,
                ["Non-smoker", "Former smoker", "Prefer not to say"],
                { prompt: "Select" } %>
          </div>

          <div class="form-group">
            <%= form.label :alcohol_consumption, "Alcohol Consumption" %>

            <%= form.select :alcohol_consumption,
                ["None", "Occasional", "Prefer not to say"],
                { prompt: "Select" } %>
          </div>

        </div>

      </div>


      <!-- BUTTONS -->

      <div class="form-actions">

        <%= link_to "Cancel",
            patient_profile_path,
            class: "cancel-btn" %>

        <%= form.submit "Save Changes",
            class: "save-profile-btn" %>

      </div>

    <% end %>

  </div>

</div>