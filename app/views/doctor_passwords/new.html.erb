<div class="login-page">

  <div class="login-card">

    <h1>Forgot Password</h1>

    <p>Please enter your registered doctor email.</p>

    <% if flash[:alert] %>
      <div class="error-message">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: doctor_forgot_password_path,
                  method: :post,
                  local: true do %>

      <div class="form-group">
        <%= email_field_tag :email,
            nil,
            placeholder: "Doctor Email",
            required: true %>
      </div>

      <%= submit_tag "Continue", class: "login-btn" %>

    <% end %>

    <div class="forgot-password">
      <%= link_to "← Back to Doctor Login", doctor_login_path %>
    </div>

  </div>

</div>